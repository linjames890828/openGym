<?xml version="1.0" encoding="utf-8"?>
<!-- One screen, three states: no workout, a set to do, a rest. Everything sits in the middle with
     room on every side, so nothing is cut off by a round face. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/no_workout"
        android:textColor="@color/muted"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/set_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/heart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/heart"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/exercise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/set_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/set_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/button_round"
                android:contentDescription="@string/prev"
                android:text="‹"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <Button
                android:id="@+id/done"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_accent"
                android:minWidth="84dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/done"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/button_round"
                android:contentDescription="@string/next"
                android:text="›"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rest_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/rest_heart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/heart"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rest"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/rest_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rest_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/rest_add"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_plain"
                android:minWidth="64dp"
                android:text="@string/plus15"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/rest_skip"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/button_accent"
                android:minWidth="64dp"
                android:text="@string/skip"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
